{
  "env": {
    "browser": true,
    "es2020": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended",
    "prettier"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": [
    "react",
    "react-hooks",
    "@typescript-eslint",
    "i18next"
  ],
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off",
    "@typescript-eslint/no-explicit-any": "warn",
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }]
  },
  "overrides": [
    {
      "files": ["src/components/**/*.tsx", "src/App.tsx"],
      "excludedFiles": ["src/test/**"],
      "rules": {
        "i18next/no-literal-string": [
          "error",
          {
            "mode": "jsx-text-only",
            "jsx-attributes": { "include": ["title", "placeholder", "aria-label", "alt", "confirmLabel"] },
            "words": { "exclude": ["Mycellia", "MYCELLIA", "true / false", "true", "false", "·", "•", ":", "⚠️", "✕", "×", "pdf", "2D", "3D", "LF", "CRLF"] }
          }
        ]
      }
    }
  ]
}
